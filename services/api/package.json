{
  "name": "@recetas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify BFF: off-chain encrypted payload store",
  "license": "Apache-2.0",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@recetas/chain": "workspace:*",
    "@recetas/crypto": "workspace:*",
    "@recetas/rules": "workspace:*",
    "@recetas/shared": "workspace:*",
    "drizzle-orm": "0.36.4",
    "fastify": "4.28.1",
    "fastify-type-provider-zod": "2.0.0",
    "pg": "8.13.1",
    "viem": "2.21.54",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.28.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
