# ---------------------------------------------------------------------------
# Production image for the doctor SPA.
#
# Unlike sigdoc's frontend (which needs no build-time configuration at all),
# this app reads VITE_* variables that Vite inlines into the built JS bundle
# AT BUILD TIME — not at container runtime (see apps/doctor/vite.config.ts and
# the root env.example, "Vite env vars are baked at build time"). They arrive
# here as Docker build ARGs, sourced in CI from GitHub repository
# Variables/Secrets (see .github/workflows/deploy.yml, build-doctor job), and
# must be promoted to ENV before `vite build` runs: Vite exposes to
# import.meta.env any already-set process.env variable whose name matches its
# envPrefix (default "VITE_"), it does not read Docker ARGs directly.
#
# Build context is the repository root (see docker-compose.prod.yml and
# .github/workflows/deploy.yml).
# ---------------------------------------------------------------------------

# --- Build stage --------------------------------------------------------------
FROM node:22-alpine AS build

RUN corepack enable

WORKDIR /app

# Manifests first so this layer is cached independently of source edits (same
# ordering as the dev image, apps/doctor/Dockerfile). The doctor app depends on
# all three workspace packages (apps/doctor/package.json).
COPY package.json pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/crypto/package.json ./packages/crypto/
COPY packages/rules/package.json ./packages/rules/
COPY apps/doctor/package.json ./apps/doctor/

RUN pnpm install --frozen-lockfile

COPY packages ./packages
# Design tokens live outside the app and are imported by src/main.tsx.
COPY design ./design
COPY apps/doctor ./apps/doctor

# Build-time configuration only. These are NOT read at container runtime:
# changing one means rebuilding and redeploying the image, never editing the
# running container (see env.production.example at the repo root).
ARG VITE_API_URL
ARG VITE_RPC_URL
ARG VITE_CHAIN_ID
ARG VITE_PRESCRIPTION_REGISTRY_ADDRESS
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_RPC_URL=${VITE_RPC_URL} \
    VITE_CHAIN_ID=${VITE_CHAIN_ID} \
    VITE_PRESCRIPTION_REGISTRY_ADDRESS=${VITE_PRESCRIPTION_REGISTRY_ADDRESS}

RUN pnpm --filter @recetas/doctor build

# --- Runtime stage: static assets served by nginx ----------------------------
FROM nginx:alpine AS runtime

COPY --from=build /app/apps/doctor/dist /usr/share/nginx/html
COPY docker/nginx/nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
