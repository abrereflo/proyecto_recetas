# ---------------------------------------------------------------------------
# Production image for the pharmacy PWA.
#
# Unlike sigdoc's frontend (which needs no build-time configuration at all),
# this app reads VITE_* variables that Vite inlines into the built JS bundle
# AT BUILD TIME — not at container runtime (see apps/pharmacy/vite.config.ts,
# apps/pharmacy/src/infrastructure/config/env.ts, and the root env.example,
# "Vite env vars are baked at build time"). They arrive here as Docker build
# ARGs, sourced in CI from GitHub repository Variables/Secrets (see
# .github/workflows/deploy.yml, build-pharmacy job), and must be promoted to
# ENV before `vite build` runs: Vite exposes to import.meta.env any
# already-set process.env variable whose name matches its envPrefix (default
# "VITE_"), it does not read Docker ARGs directly.
#
# nginx.prod.conf (shared with the doctor image) additionally makes sure this
# app's service worker (public/sw.js) and manifest.webmanifest are never
# cached, so a new deploy is actually picked up by returning visitors — see
# the comment in docker/nginx/nginx.prod.conf.
#
# Build context is the repository root (see docker-compose.prod.yml and
# .github/workflows/deploy.yml).
# ---------------------------------------------------------------------------

# --- Build stage --------------------------------------------------------------
FROM node:22-alpine AS build

RUN corepack enable

WORKDIR /app

# Manifests first so this layer is cached independently of source edits (same
# ordering as the dev image, apps/pharmacy/Dockerfile). The pharmacy app
# depends on shared, crypto and chain, NOT rules (apps/pharmacy/package.json).
# Every one of them must have its manifest here BEFORE the install: pnpm only
# links a workspace package it can see at install time, so a manifest missing
# here leaves that package without node_modules and `tsc` later fails to
# resolve its own dependencies (viem, in chain's case).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/crypto/package.json ./packages/crypto/
COPY packages/chain/package.json ./packages/chain/
COPY apps/pharmacy/package.json ./apps/pharmacy/

RUN pnpm install --frozen-lockfile

COPY packages ./packages
# Design tokens live outside the app and are imported by src/main.tsx.
COPY design ./design
COPY apps/pharmacy ./apps/pharmacy

# Build-time configuration only. These are NOT read at container runtime:
# changing one means rebuilding and redeploying the image, never editing the
# running container (see env.production.example at the repo root).
ARG VITE_API_URL
ARG VITE_RPC_URL
ARG VITE_CHAIN_ID
ARG VITE_PRESCRIPTION_REGISTRY_ADDRESS
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_RPC_URL=${VITE_RPC_URL} \
    VITE_CHAIN_ID=${VITE_CHAIN_ID} \
    VITE_PRESCRIPTION_REGISTRY_ADDRESS=${VITE_PRESCRIPTION_REGISTRY_ADDRESS}

RUN pnpm --filter @recetas/pharmacy build

# --- Runtime stage: static assets served by nginx ----------------------------
FROM nginx:alpine AS runtime

COPY --from=build /app/apps/pharmacy/dist /usr/share/nginx/html
COPY docker/nginx/nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
