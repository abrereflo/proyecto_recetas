# ---------------------------------------------------------------------------
# Production environment template.
#
#   cp env.production.example .env
#   chmod 600 .env
#
# Named without a leading dot, like env.example, so it is visible next to the
# development template rather than hidden.
#
# This file lives on the droplet at /opt/docker/apps/recetas/.env. Compose
# reads it two ways: `env_file: .env` on the api service (injected into that
# container at runtime) and `${VAR}` substitution for the values that
# docker-compose.prod.yml itself needs (the database credentials). See
# docs/19-despliegue.md for the full procedure.
#
# Never commit a real .env. Real patient data is forbidden outside the pilot
# environment (docs/08-stack-y-entorno.md).
# ---------------------------------------------------------------------------

# --- Postgres ---------------------------------------------------------------
# POSTGRES_PASSWORD is a secret. POSTGRES_DB and POSTGRES_USER are config.
POSTGRES_DB=recetas
POSTGRES_USER=recetas
POSTGRES_PASSWORD=CHANGE_ME

# --- API (config) -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
NODE_ENV=production
LOG_LEVEL=info
# DATABASE_URL and CORS_ORIGIN are deliberately absent here: both are pinned in
# the api.environment block of docker-compose.prod.yml, because the database
# hostname inside the Docker network and the allowed origins must match the
# Traefik Host() rules exactly and must not drift with an edit to this file.

# --- Chain: Base Sepolia (production network; no Anvil here) ----------------
# CHAIN_ID and RPC_URL are config. The addresses below are deployment-specific:
# get one wrong and verification silently reads the wrong contract or the wrong
# credential schema, which fails closed but looks like a credential problem.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# Address of the deployed PrescriptionRegistry (contracts/script/Deploy.s.sol).
PRESCRIPTION_REGISTRY_ADDRESS=CHANGE_ME

# EAS on Base Sepolia. Professional credentials are read as attestations
# against these schemas (docs/02-roles-y-permisos.md). The canonical EAS
# predeploy on Base Sepolia is 0x4200000000000000000000000000000000000021 and
# its SchemaRegistry is 0x4200000000000000000000000000000000000020; both were
# verified live and report version 1.2.0 (docs/16-plan-de-ejecucion.md).
EAS_ADDRESS=0x4200000000000000000000000000000000000021
PRACTITIONER_SCHEMA_UID=CHANGE_ME
PHARMACY_SCHEMA_UID=CHANGE_ME

# The only attester whose credentials count. A multisig in the pilot (docs/02).
ISSUER_AUTHORITY=CHANGE_ME

# --- Build-time frontend configuration (VITE_*) -----------------------------
# NOT read from this file at runtime, and not read by any container at all.
# Vite bakes these into the built JavaScript at `docker build` time (see
# docker/Dockerfile.doctor.prod and docker/Dockerfile.pharmacy.prod); in CI they
# are passed as Docker build args sourced from GitHub repository Variables (see
# .github/workflows/deploy.yml). They are listed here so that the full set of
# values a production deploy depends on is documented in one place.
#
# Changing any of these requires a new image build and a redeploy. A container
# restart will not pick them up, and neither will editing this file.
VITE_API_URL=https://recetas.devrafaseros.com/api
VITE_RPC_URL=https://sepolia.base.org
VITE_CHAIN_ID=84532
VITE_PRESCRIPTION_REGISTRY_ADDRESS=CHANGE_ME
