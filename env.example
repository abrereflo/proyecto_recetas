# ---------------------------------------------------------------------------
# Environment template.
#
#   cp env.example .env
#
# Defaults target the RECOMMENDED mode: infrastructure in Docker, application
# processes on the host (see README "Modos de ejecucion"). Hosts are therefore
# localhost. The Docker-internal values are documented inline next to each one
# and are injected automatically by docker-compose.yml for the `apps` profile,
# so the same .env serves both modes.
#
# Never commit .env. Real patient data is forbidden outside the pilot
# environment (docs/08-stack-y-entorno.md).
# ---------------------------------------------------------------------------

# --- Postgres (off-chain encrypted payload store, docs/05 D-08) -------------
POSTGRES_USER=recetas
POSTGRES_PASSWORD=recetas
POSTGRES_DB=recetas
POSTGRES_PORT=5432

# Host mode (default). Inside the Docker network the host is `postgres`:
#   postgres://recetas:recetas@postgres:5432/recetas
DATABASE_URL=postgres://recetas:recetas@localhost:5432/recetas

# --- API --------------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Chain ------------------------------------------------------------------
# Local development chain (Anvil in Compose).
ANVIL_PORT=8545
ANVIL_CHAIN_ID=31337
ANVIL_BLOCK_TIME=2

# Host mode (default). Inside the Docker network the host is `anvil`:
#   http://anvil:8545
RPC_URL=http://localhost:8545
CHAIN_ID=31337

# Integration network: Avalanche Fuji (chainId 43113).
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_CHAIN_ID=43113
# Address of the deployed PrescriptionRegistry. Empty until Deploy.s.sol runs.
PRESCRIPTION_REGISTRY_ADDRESS=

# --- Professional credentials (EAS, docs/04) --------------------------------
# Read at deploy time and burnt into the registry as immutables. On chainId
# 31337 they default to a MockEAS deployed by the script; anywhere else
# Deploy.s.sol refuses to run with any of them empty.
# Avalanche has NO official EAS deployment, so there is no canonical address to
# paste here: this project deploys its own EAS v1.2.0 with
# contracts/script/DeployEAS.s.sol and fills in the two addresses it prints.
EAS_ADDRESS=
# SchemaRegistry from that same deployment. Read by RegisterSchemas.s.sol.
SCHEMA_REGISTRY_ADDRESS=
# Schema uids printed by contracts/script/RegisterSchemas.s.sol, one per
# professional role. NOT the local stand-ins of script/LocalDemo.sol.
PRACTITIONER_SCHEMA_UID=
PHARMACY_SCHEMA_UID=
# The only attester whose credentials count, burnt into the registry as an
# `immutable`: a wrong value here can only be fixed by redeploying. In the MVP
# deployment of 13/09/2026 this is the DEPLOYER account itself, because it is
# the only key the project holds. A separate authority (a multisig) remains the
# pilot target, and until then deployer and authority are the same account.
ISSUER_AUTHORITY=

# Deployment key. NEVER a key holding real funds, NEVER committed (docs/08).
DEPLOYER_PRIVATE_KEY=
# Fuji is a paid tier on Etherscan V2, so verification goes through Routescan,
# whose Etherscan-compatible API takes the literal string below as its key
# (contracts/foundry.toml). CONFIRMED on the first Fuji deployment (13/09/2026):
# the source was queued for a few seconds and then verified.
ROUTESCAN_API_KEY=verifyContract

# --- Frontends --------------------------------------------------------------
DOCTOR_PORT=5173
PHARMACY_PORT=5174
# Browser-side values. The browser always talks to published ports on the host,
# so these stay on localhost in both modes.
VITE_API_URL=http://localhost:3000
VITE_RPC_URL=http://localhost:8545
VITE_CHAIN_ID=31337
VITE_PRESCRIPTION_REGISTRY_ADDRESS=

# --- ERC-4337 ---------------------------------------------------------------
# THERE IS NO BUNDLER AND NONE IS NEEDED. The v0.7 EntryPoint exposes
# `handleOps` as `public` with no access control, so this project's own relayer
# submits operations directly (services/api/src/relayer/). That does NOT make it
# a bundler: no mempool, no bundling, no ERC-7562, no reputation, no stake. It
# is also the only thing that works with this paymaster, which [OP-011] and
# [STO-033] make incompatible with a public bundler. See docs/18, Fase 5.
# permissionless.js is still deliberately not installed.
BUNDLER_RPC_URL=
PAYMASTER_RPC_URL=

# --- Own relayer (Fase 5 item 5) --------------------------------------------
# THREE VARIABLES GATE THE RELAYER: RELAYER_PRIVATE_KEY and
# PRESCRIPTION_PAYMASTER_ADDRESS below, plus PRESCRIPTION_REGISTRY_ADDRESS above.
# Without all three the relayer does NOT register and /relayer answers 404. The
# encrypted store boots regardless.
#
# PASSKEY_ACCOUNT_FACTORY_ADDRESS is NOT one of them. Left empty the relayer still
# starts and still carries a first operation whose `initCode` the client built
# itself; what it cannot do is build that `initCode` — deriving the counterfactual
# address needs the factory — so /prepare refuses with `factory_not_configured`.
#
# The relayer's key. It pays the TRANSACTION that carries the UserOperation; the
# operation's own gas comes from the paymaster's deposit. NEVER a key holding
# real funds, NEVER committed (docs/08). It is written to no log and travels in
# no response: `GET /relayer` returns only the derived address.
RELAYER_PRIVATE_KEY=
# PrescriptionPaymaster. The only paymaster this relayer accepts in
# `paymasterAndData`: carrying operations sponsored by a third party would mean
# paying the whole cost for none of the purpose. Not deployed as of 2026-09-13.
PRESCRIPTION_PAYMASTER_ADDRESS=
# PasskeyAccountFactory. Needed only to build the `initCode` of an account that
# does not exist yet. Not deployed as of 2026-09-13.
PASSKEY_ACCOUNT_FACTORY_ADDRESS=

# EntryPoint v0.7, canonical on every chain that has it. Override only for a
# local chain.
ENTRY_POINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Ceilings that bound what ONE submission may cost.
# Maximum maxFeePerGas, in wei. Default 100 nAVAX. Fuji's base fee is dynamic:
# measured at 10 wei on 2026-09-13, nine orders of magnitude below the 25 nAVAX
# the older documents assumed. That is why the fee is READ from the chain and
# this is only the cap.
RELAYER_MAX_FEE_PER_GAS_WEI=100000000000
# Maximum prefund per operation, in wei. Mirrors the paymaster's `maxCostPerOp`
# (0.06 AVAX recommended) so a refusal arrives as a sentence instead of as an
# `AA33 reverted` wrapping `CostNotSponsored`. This was 0.02 until the relayer
# measured the real cost: an earlier guess of "on the order of 800k gas" turned
# out to be less than half of what an account's FIRST operation reserves, which
# is over 1.8M, so the old ceiling would have made the paymaster refuse its own
# bootstrap. See the constructor NatSpec in PrescriptionPaymaster.sol.
RELAYER_MAX_PREFUND_WEI=60000000000000000

# The endpoint is open and unauthenticated on purpose: the doctor has no account
# yet, and an API key inside a SPA is a public string. The real access control is
# the EAS credential, which the paymaster re-reads on every operation. What needs
# protecting is the relayer's balance, and a rate limit is what protects it.
RELAYER_RATE_LIMIT=30
RELAYER_RATE_LIMIT_WINDOW_SECONDS=60
